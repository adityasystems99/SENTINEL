# ==============================================================================
# SENTINEL Environment Configuration Template
# Copy this file to .env and configure appropriate values before deployment.
# NEVER commit the active .env file with real secrets.
# ==============================================================================

# Application Environment
SENTINEL_ENV=production
SENTINEL_DEBUG=false

# Authentication & Access Control (Task 1)
# Set to 'true' to strictly enforce token/key verification on all protected endpoints.
SENTINEL_AUTH_ENABLED=true
SENTINEL_API_KEY=replace-with-a-cryptographically-secure-random-token-minimum-32-chars
SENTINEL_ADMIN_API_KEY=replace-with-a-different-admin-level-secret-token

# CORS Origins (Task 3)
# Comma-separated list of permitted frontend origins. Do NOT use '*' when auth is enabled.
SENTINEL_CORS_ORIGINS=https://sentinel.yourdomain.com

# Networking & Reverse Proxy (Task 2)
# Set to 'true' if running behind a trusted reverse proxy (NGINX, Cloudflare, Traefik, AWS ALB)
# to safely parse X-Forwarded-For headers for client rate limiting.
BEHIND_TRUSTED_PROXY=false

# In-Memory Rate Limiting (Task 2)
RATE_LIMIT_PER_MINUTE=120
EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
MAX_TELEMETRY_BATCH_SIZE=1000

# Storage Directories (Task 4)
# Persistent disk mount path for projects and metadata
DATA_DIR=data
PROJECTS_DIR=data/projects

# Frontend Client Configuration (Vite)
VITE_API_BASE_URL=/api
VITE_SENTINEL_API_KEY=replace-with-a-cryptographically-secure-random-token-minimum-32-chars
